# -----------------------------------------------------------------------------
# SocialVibe - Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` or `.env` and fill in your actual credentials.
# Command: cp .env.example .env.local

# -----------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string for PostgreSQL (e.g., Neon.tech, Supabase, or local PostgreSQL)
# Example: postgresql://postgres:password@localhost:5432/socialvibe?schema=public
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# -----------------------------------------------------------------------------
# 2. Clerk Authentication (https://dashboard.clerk.com)
# -----------------------------------------------------------------------------
# Found under "API Keys" in your Clerk Dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# Optional Clerk redirect URLs (if using custom login routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/login"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# -----------------------------------------------------------------------------
# 3. UploadThing File Storage (https://uploadthing.com/dashboard)
# -----------------------------------------------------------------------------
# Found under "API Keys" in your UploadThing Dashboard (API Token for UploadThing v7+)
UPLOADTHING_TOKEN="your_uploadthing_api_token"